@startuml star-collector-deployment
title Star Collector - Deployment View

!$NODE_TYPE_MAX_CHAR_WIDTH = 28
!$NODE_DESCR_MAX_CHAR_WIDTH = 32

System_Ext(linkding, "linkding", "Self-hosted at bookmarks.ping13.net: RSS feed, REST API")
System_Ext(apis, "External APIs", "Mastodon, LinkedIn, Kagi Extract, OpenRouter, Hacker News")

Deployment_Node(github, "GitHub", "github.com") {
  Deployment_Node(sc_repo, "ping13/star-collector", "Public repository, Actions") {
    Deployment_Node(run, "Publish my stars run", "ubuntu-latest, hourly at :04 + manual") {
      Container(summarizer, "Bookmark summarizer", "Job 1: summarize-bookmarks", "bookmark_summaries.py --apply")
      Container(generator, "Feed generator", "Job 2: rss-deploy", "rss.py, validate, compare, FTP upload, blog dispatch")
    }
    ContainerDb(cache, "Title cache", "GitHub Actions cache", "Restored and saved by every feed run")
    ContainerDb(secrets, "Secrets and variables", "Environment default", "API tokens, FTP password, token expiry dates")
  }
  Deployment_Node(blog_repo, "ping13/blog", "Private repository, Actions") {
    Container(favorites, "Favorites workflow", "Pelican, favorites.yaml", "Builds and uploads only favorites/index.html")
  }
}

Deployment_Node(cyon, "Web hosting", "cyon.ch, FTP") {
  ContainerDb(feed, "rss.ping13.net", "public_html/rss", "stars.rss, linkedin-state.json")
  ContainerDb(site, "blog.heuel.org", "public_html/blog", "Static blog, favorites page")
}


summarizer --> linkding : reads bookmarks,\nwrites descriptions
summarizer --> apis : Kagi, OpenRouter, HN
generator --> linkding : reads the RSS feed
generator --> apis : Mastodon, LinkedIn,\nOpenRouter
generator --> cache : reads/writes
generator --> feed : uploads (FTP)
generator --> favorites : workflow_dispatch\nif the feed changed
favorites --> feed : reads stars.rss
favorites --> site : uploads favorites page (FTP)
run ..> secrets : uses

@enduml
