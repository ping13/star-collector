@startuml star-collector-component
title Star Collector - Feed Generator Components

LAYOUT_TOP_DOWN()

System_Ext(mastodon, "Mastodon", "Favourites API")
System_Ext(linkding, "linkding", "Bookmarks RSS feed")
System_Ext(linkedin, "LinkedIn", "Changelog API, public post pages")
System_Ext(openrouter, "OpenRouter", "Claude Haiku, Qwen fallback")
System_Ext(webhost, "Web host", "rss.ping13.net")

Container_Boundary(generator, "Feed generator (rss.py)") {
  Component(entry, "CLI entrypoint", "click", "Parses limit and output options, writes the RSS document")
  Component(core, "StarRSSGenerator", "rss.py", "Loads the config, collects all sources and sorts the merged items")
  Component(mastodon_fetch, "Mastodon fetcher", "requests", "Pages through favourites, turns posts into items")
  Component(rss_fetch, "RSS fetcher", "feedparser", "Reads the linkding feed, drops excluded tags, adds the source domain")
  Component(linkedin_mod, "LinkedIn collector", "linkedin.py", "Reads changelog events, merges them into the stored state, looks up post texts")
  Component(titles, "Title extractor", "extract_titles.py", "Short headlines for posts, with model fallback and a per-run budget")
  ComponentDb(cache, "Title cache", "diskcache", "Headlines by model, prompt version and text")
  ComponentDb(state, "LinkedIn state", "build/linkedin-state.json", "Reactions of the last weeks and the changelog cursor")
  Component(builder, "Feed builder", "feedgen", "RSS 2.0 document with categories and sources")
}

Rel(entry, core, "Generates the feed")
Rel(core, mastodon_fetch, "Fetches favourites")
Rel(core, rss_fetch, "Fetches bookmarks")
Rel(core, linkedin_mod, "Collects reactions")
Rel(core, builder, "Adds items")
Rel(mastodon_fetch, titles, "Headline per post")
Rel(linkedin_mod, titles, "Headline per post")
Rel(titles, cache, "Reads and writes")
Rel(linkedin_mod, state, "Reads and writes")

Rel(mastodon_fetch, mastodon, "GET favourites", "HTTPS/JSON")
Rel(rss_fetch, linkding, "Reads feed", "RSS")
Rel(linkedin_mod, linkedin, "Changelog, post pages", "HTTPS")
Rel(linkedin_mod, webhost, "Loads the published state if no local file", "HTTPS")
Rel(titles, openrouter, "Chat completion", "HTTPS/JSON")


@enduml
