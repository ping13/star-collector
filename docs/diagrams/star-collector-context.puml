@startuml star-collector-context
title Star Collector - System Context

LAYOUT_LANDSCAPE()

Person(owner, "Owner", "Stars Mastodon posts, reacts on LinkedIn and saves bookmarks in linkding")
Person(readers, "Readers", "Subscribe to the feed or read the favorites page on the blog")
System(system, "Star Collector", "Hourly GitHub Actions job: fills missing bookmark descriptions and merges all stars into one RSS feed")

System_Ext(mastodon, "Mastodon", "swiss.social: favourites of the owner")
System_Ext(linkedin, "LinkedIn", "Member Data Portability API (reactions, reposts) and public post pages")
System_Ext(linkding, "linkding", "Self-hosted bookmarks (bookmarks.ping13.net): RSS feed and REST API")
System_Ext(openrouter, "OpenRouter", "LLM gateway (Claude Haiku, Qwen fallback): headlines and summaries")
System_Ext(kagi, "Kagi Extract API", "Fetches bookmarked pages as Markdown")
System_Ext(hn, "Hacker News API", "Resolves HN stories to the article they link to")
System_Ext(webhost, "Web host", "rss.ping13.net (FTP): serves stars.rss and the LinkedIn state")
System_Ext(blog, "Blog", "blog.heuel.org, built by GitHub Actions in ping13/blog: favorites page")

Rel_R(owner, mastodon, "Stars posts")
Rel_D(owner, linkding, "Saves bookmarks")
Rel_D(system, mastodon, "Reads favourites", "HTTPS/JSON")
Rel_D(system, linkedin, "Reads reactions and post texts", "HTTPS")
Rel_L(system, linkding, "Reads bookmarks feed, writes summaries", "RSS, REST")
Rel_U(system, openrouter, "Generates headlines and summaries", "HTTPS/JSON")
Rel_U(system, kagi, "Extracts page content", "HTTPS/JSON")
Rel_U(system, hn, "Looks up story URLs", "HTTPS/JSON")
Rel_R(system, webhost, "Uploads feed and state", "FTP")
Rel_R(system, blog, "Starts favorites rebuild when the feed changed", "GitHub workflow_dispatch")
Rel_U(blog, webhost, "Reads stars.rss at build time", "HTTPS")
Rel_L(readers, webhost, "Subscribe to stars.rss", "RSS")
Rel_U(readers, blog, "Read the favorites page", "HTTPS")

Lay_R(openrouter, kagi)
Lay_R(kagi, hn)
Lay_R(mastodon, linkedin)
Lay_D(webhost, blog)
Lay_U(owner, linkding)

@enduml
