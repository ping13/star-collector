@startuml star-collector-container
title Star Collector - Container View

LAYOUT_TOP_DOWN()

System_Ext(linkding, "linkding", "Bookmarks: RSS feed and REST API")
System_Ext(kagi, "Kagi Extract API", "Page content as Markdown")
System_Ext(hn, "Hacker News API", "Story -> article URL")
System_Ext(openrouter, "OpenRouter", "Claude Haiku, Qwen fallback")
System_Ext(mastodon, "Mastodon", "Favourites")
System_Ext(linkedin, "LinkedIn", "Reactions API, public post pages")
System_Ext(webhost, "Web host", "rss.ping13.net: stars.rss, linkedin-state.json")
System_Ext(blog, "Blog", "ping13/blog favorites workflow")

System_Boundary(sc, "Star Collector") {
  Container(workflow, "Publish workflow", "GitHub Actions, upload.yaml", "Hourly: summarize job first, then the feed job; uploads the feed and starts the blog rebuild")
  Container(summarizer, "Bookmark summarizer", "Python, bookmark_summaries.py", "Replaces empty or generic linkding descriptions with LLM summaries")
  Container(generator, "Feed generator", "Python, rss.py + linkedin.py + extract_titles.py", "Merges Mastodon, linkding and LinkedIn items into one RSS feed")
  ContainerDb(config, "Config and secrets", "sc_config.yaml + GitHub secrets", "Sources, models, limits and API tokens")
  ContainerDb(titles, "Title cache", "diskcache in the GitHub Actions cache", "Generated headlines, so only new posts cost money")
}

Rel_D(workflow, summarizer, "1. runs: last 3 hours, a week at 02:04")
Rel_D(workflow, generator, "2. runs, also if 1. failed")
Rel_R(workflow, webhost, "Uploads feed and state", "FTP")
Rel_R(workflow, blog, "Starts rebuild if items changed", "workflow_dispatch")

Rel_L(summarizer, linkding, "Lists bookmarks, writes descriptions", "REST")
Rel_L(summarizer, kagi, "Extracts pages", "HTTPS")
Rel_L(summarizer, hn, "Resolves stories", "HTTPS")
Rel_D(summarizer, openrouter, "Writes summaries", "HTTPS")
Rel_D(summarizer, config, "Reads")

Rel_R(generator, mastodon, "Reads favourites", "HTTPS")
Rel_R(generator, linkedin, "Reads reactions, post texts", "HTTPS")
Rel_L(generator, linkding, "Reads bookmarks feed", "RSS")
Rel_D(generator, openrouter, "Generates headlines", "HTTPS")
Rel_D(generator, titles, "Reads and writes")
Rel_D(generator, config, "Reads")

Lay_R(summarizer, generator)
Lay_R(config, titles)
Lay_D(linkding, kagi)
Lay_D(kagi, hn)
Lay_D(mastodon, linkedin)
Lay_D(blog, mastodon)
Lay_D(webhost, blog)

@enduml
